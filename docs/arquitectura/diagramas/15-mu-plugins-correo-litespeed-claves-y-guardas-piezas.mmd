%% Piezas del capítulo 15 — correo SMTP y su centinela, LiteSpeed, claves, redirecciones, logs y solo-local.
%% Qué muestra: los doce mu-plugins del área agrupados por dominio, con quién habla cada uno y qué datos deja.
%% Leyenda de colores: naranja = código propio de Akibara · gris azulado = software de terceros ·
%% verde = personas · morado = datos que quedan escritos (options y ficheros).
flowchart TB
    classDef propio fill:#fff3e0,stroke:#e07b39,stroke-width:1.5px,color:#4a2c10
    classDef tercero fill:#eef2f7,stroke:#7a90a8,stroke-width:1.5px,color:#22303f
    classDef persona fill:#e8f5e9,stroke:#4c8c4a,stroke-width:1.5px,color:#1b3a1c
    classDef dato fill:#f3e8fd,stroke:#8b5cf6,stroke-width:1.5px,color:#3a1d5c

    subgraph LEYENDA["Leyenda"]
        direction LR
        L1["código propio de Akibara"]:::propio
        L2["software de terceros"]:::tercero
        L3["personas"]:::persona
        L4[("datos que quedan escritos")]:::dato
    end

    DUENO["Dueño<br/>mira el admin de WordPress"]:::persona
    CLIENTE["Cliente<br/>compra y espera su correo"]:::persona
    QA["QA<br/>prueba en el espejo Docker"]:::persona

    subgraph CORREO["Correo · el eslabón crítico"]
        CEPO["akibara-correo-no-sale-a-clientes.php<br/>fuera de producción desvía todo a una bandeja falsa"]:::propio
        CARTERO["akibara-correo-smtp.php · clase Transport<br/>único transporte SMTP real de la tienda"]:::propio
        CENTINELA["akibara-mail-transport-watch.php · clase Watch<br/>vigila desde fuera que el cartero siga vivo"]:::propio
        INVENTARIO["akibara-provider-access.php<br/>catálogo de claves, pantalla y gate del despliegue"]:::propio
    end

    subgraph BARANDAS["Barandas y arreglos puntuales"]
        LS["akibara-litespeed-guardrails.php<br/>fija cuatro opciones de caché por código"]:::propio
        SITEMAP["akibara-discovery-warming.php<br/>cabeceras de caché de los mapas del sitio"]:::propio
        HTTPS["akibara-https-urls-fuera-de-web.php<br/>fuerza https en cron y consola"]:::propio
        I18N["akibara-woo-blocks-i18n.php<br/>arregla la concordancia del checkout"]:::propio
        RM["akibara-rankmath-redirections-abilities.php<br/>expone las redirecciones por MCP"]:::propio
    end

    subgraph LOCAL["Sólo en el ordenador de desarrollo"]
        ROT["akibara-debug-log-rotation.php<br/>rota el log y separa los fatales"]:::propio
        SPAWN["akibara-local-cron-spawn.php<br/>hace resoluble el auto-disparo del cron"]:::propio
        IDX["akibara-local-external-indexing-guard.php<br/>corta los avisos a IndexNow"]:::propio
    end

    PANEL["akibara-panel<br/>menú del admin que registra Akibara Business"]:::propio
    DEPLOY["ops/akibara-prod-muplugins-deploy.sh<br/>sube los mu-plugins y llama a los dos jueces"]:::propio
    HEALTH["ops/akibara-prod-mail-health.sh<br/>sonda de salud del correo, sólo lectura"]:::propio

    WOO["WooCommerce<br/>emite todo correo de pedido"]:::tercero
    SMTP["smtp.hostinger.com<br/>buzón contacto arroba akibara.cl"]:::tercero
    MAILPIT["Mailpit<br/>buzón de pruebas del espejo"]:::tercero
    LITESPEED["LiteSpeed Cache 7.9.1<br/>caché y optimización"]:::tercero
    RANKMATH["Rank Math<br/>mapas del sitio y redirecciones"]:::tercero
    HPANEL["Cron de hPanel<br/>llama a wp-cron.php cada 5 minutos"]:::tercero
    ASWPCLI["Action Scheduler y WP-CLI<br/>generan correo sin visita web"]:::tercero

    OUTAGE[("akibara_mail_transport_outage<br/>rastro del corte vigente")]:::dato
    WATCH[("akibara_mail_transport_watch<br/>historial de reposiciones")]:::dato
    RESCATE[("akb-runtime/akibara-correo-smtp.php<br/>copia de rescate fuera de la web")]:::dato

    CLIENTE --> WOO
    WOO --> CEPO
    CEPO --> CARTERO
    CARTERO --> SMTP
    CEPO -. "sólo en el espejo" .-> MAILPIT
    CARTERO --> OUTAGE
    OUTAGE -. "aviso rojo, exige manage_woocommerce" .-> DUENO
    CENTINELA --> CARTERO
    CENTINELA --> WATCH
    CENTINELA --> RESCATE
    WATCH -. "aviso amarillo, exige manage_woocommerce" .-> DUENO
    HPANEL --> CENTINELA
    INVENTARIO -. "comprueba que el fichero exista" .-> CARTERO
    INVENTARIO -- "pantalla Claves y accesos, exige manage_options" --> PANEL
    PANEL -- "el menú padre exige manage_woocommerce" --> DUENO
    QA --> CEPO
    QA --> MAILPIT

    DUENO --> DEPLOY
    DEPLOY -- "gate wp akibara access-check" --> INVENTARIO
    DEPLOY -- "mantiene al día la copia" --> RESCATE
    DEPLOY --> HEALTH
    HEALTH -. "abre SMTP real sin enviar nada" .-> SMTP

    LS --> LITESPEED
    SITEMAP --> RANKMATH
    RM --> RANKMATH
    I18N --> WOO
    ASWPCLI --> HTTPS
    HTTPS -. "arregla las imágenes del cuerpo" .-> WOO
    ROT -.-> QA
    SPAWN -.-> QA
    IDX -.-> RANKMATH
