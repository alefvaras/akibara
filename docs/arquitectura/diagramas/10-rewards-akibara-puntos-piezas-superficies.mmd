    CLIENTE --> CAJA
    CLIENTE --> GANCHO
    CLIENTE --> PDP
    CLIENTE --> PROG
    MAIL --> CLIENTE
    DUENO --> MIG
    DUENO --> AUD
    DUENO --> LOG

    MOTOR --> MAIL
    MOTOR --> TABLA
    MOTOR --> UMETA
