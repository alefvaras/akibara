    MOTOR --> LOG

    ACCT --> MOTOR
    CAJA --> MOTOR
    PDP --> MOTOR
    PROG --> MOTOR
    ASSETS --> CAJA
    ASSETS --> GANCHO

    MIG --> TABLA
    MIG --> OPTS
    AUD --> UMETA
    PRIV --> TABLA
