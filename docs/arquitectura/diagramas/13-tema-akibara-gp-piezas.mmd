  Perf -->|"filtro akibara/popular_product_ids"| Business
  SiteCopy --> OptCopy
  Trust -->|"promesa de cuotas"| SiteCopy
  Trust --> TrustCheck
  Trust -->|"akibara_gp_icon()"| Icons

  Header -->|"NavigationLinks, Wishlist::count"| Business
  Header -->|"akibara_search_suggest_active"| Search
  Footer -->|"horario y teléfono"| SiteCopy
  Footer --> ThemeMod
  Footer --> Icons
  Header --> Icons
  Blog --> Contenido
  PageHdr --> GP
  PageHdr -.-> RamaCheckout
  RamaCheckout -.->|"quien SÍ suprime el H1<br/>es el plugin de bloques"| Blocks
  Fn --> PageHdr
  Fn --> Blog
  Fn --> SiteCopy
  Fn --> Icons
  Fn --> RankMath
  BottomNav --> Business
  Contenido --> OptPost
  Brands -->|"locate_template"| Business
  Cross --> Business
  Overrides -->|"cart-empty por shortcode"| Blocks
  Nav --> GP
  GPCompat --> GP
  Setup --> GP

  Main --> Bridge
  Bridge --> Woo
  Guard --> Woo
  Pdp -->|"wc-ajax=add_to_cart"| Woo
  Pdp -->|"akb_get_cart&drain_notices=1"| Business
  Anim -->|"window.akbCart.open()<br/>animations.js:237"| Business
  Anim -->|"evento akb:pjax"| Search
  Sticky --> Pdp
