#!/usr/bin/env bash
# .githooks/pre-commit
# Guardrail de calidad y consistencia documental pre-commit de Akibara.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# 0. Candado criptográfico DevSecOps (impide commitear rebajas de reglas o baselines)
if [[ -f "${repo_root}/tools/verify-devsecops-seal.py" ]]; then
    python3 "${repo_root}/tools/verify-devsecops-seal.py" || {
        printf '\n❌ [PRE-COMMIT] Violación del candado DevSecOps. Prohibido alterar reglas de análisis o crear baselines.\n' >&2
        exit 1
    }
fi

# 1. Privacidad y datos sensibles en staging (sin || true ni ocultamiento de errores)
python3 "${repo_root}/tools/guard-private-data.py" --staged || {
    printf '\n❌ [PRE-COMMIT] Datos privados o secretos detectados en staging.\n' >&2
    exit 1
}

# 2. Guardrail anti-supresiones R1-R4 (R5 incremental en PHP en stage)
staged_php="$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)"
r5_flag="off"
if [[ -n "$staged_php" ]]; then
    r5_flag="changed"
fi
php "${repo_root}/tools/guardrail-suppressions.php" --staged --r5="$r5_flag" || {
    printf '\n❌ [PRE-COMMIT] Bloqueado por Guardrail Anti-Supresiones (R1-R5).\n' >&2
    exit 1
}

# 3. Verificación de sintaxis PHP y AST Hygiene en archivos staged
if [[ -n "$staged_php" ]]; then
    printf '%s\n' "$staged_php" | xargs -P 8 -I {} php -l "${repo_root}/{}" >/dev/null || {
        printf '\n❌ [PRE-COMMIT] Error de sintaxis PHP en archivos staged. Corrige antes de commitear.\n' >&2
        exit 1
    }

    # 4. AST Hygiene estricto sobre el runtime completo (1.4s en lote)
    if [[ -f "${repo_root}/tools/guardrail-ast-hygiene.php" ]]; then
        php "${repo_root}/tools/guardrail-ast-hygiene.php" --fail-on-error --fail-on-warning >/dev/null || {
            printf '\n❌ [PRE-COMMIT] Violación de Guardrail AST.\n' >&2
            exit 1
        }
    fi
fi

# 5. Watchdog documental y regeneración continua de volúmenes de código para NotebookLM
if [[ -f "${repo_root}/tools/doc-drift-watchdog.mjs" ]] && command -v node >/dev/null 2>&1; then
    node "${repo_root}/tools/doc-drift-watchdog.mjs"
fi
