  "search_feed_contract": {
    "version": "2",
    "previous": "1",
    "forces_rebuild": true,
    "justification": "Se mantiene en 2: la semántica publicada no cambió (precio autoritativo o ningún precio) y producción nunca adoptó el contrato 2 —1.99.14 no se promovió—, así que el salto 1->2 sigue pendiente y ya fuerza el rebuild necesario. Un 3 agendaría un segundo rebuild sin cambiar lo materializado.",
    "provider_contract": "akb_search_effective_price lanza PriceAuthorityUnavailable cuando el precio no es autoritativo.",
    "public_api": [
      "SearchPriceProvider::prepare_authoritative_snapshot(): string  // invalida memos, toma la foto, devuelve token; lanza si no se acredita",
      "SearchPriceProvider::snapshot_is_fresh(string $token): bool     // final-check",
      "SearchPriceProvider::snapshot_token(): string",
      "SearchPriceProvider::is_authoritative(): bool",
      "SearchPriceProvider::AUTHORITY_FILTER = 'akb_price_authority_available'",
      "DiscountResolver::invalidate_derived_memos(): void",
      "DiscountResolver::prime_authoritative_snapshot(): void",
      "DiscountResolver::resolve_strict(WC_Product): ?float",
      "SearchPriceProvider::authoritative_snapshot(): array  // snapshot canónico comparable con el de Search"
    ]
  },
