{
  "name": "akibara/root-quality",
  "description": "Stack integral de análisis estático, seguridad y calidad para Akibara.",
  "type": "project",
  "license": "proprietary",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
