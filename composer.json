    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "rector/rector": "^2.8",
    "shipmonk/dead-code-detector": "^1.0",
    "staabm/phpstan-dba": "^0.5.4",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "tomasvotruba/cognitive-complexity": "^1.0",
    "vimeo/psalm": "^7.2",
    "woocommerce/woocommerce-sniffs": "^2.0"
  }
